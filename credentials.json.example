{
  "username": "your_jaccount_username",
  "password": {
    "mode": "env",
    "key": "JACCOUNT_PASSWORD"
  },
  "room_id": "your_dorm_room_id",
  "door_access_token": "optional_api_token",
  "checkin_poll_url": "http://localhost:8080/checkin-data",
  "checkin_poll_interval": 1.0,
  "notifications": {
    "ntfy": {
      "enabled": true,
      "server": "https://ntfy.sh",
      "topic": "your-unique-topic",
      "token": {
        "mode": "env",
        "key": "NTFY_TOKEN"
      },
      "tags": ["sjtu", "daemon"],
      "priority": "high"
    }
  }
}
